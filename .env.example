# Inkwell — Markdown social network. Copy to .env and fill in real values.
# NEVER commit .env.

# PostgreSQL connection string used by the application (and by goose migrations).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/markdown_social?sslmode=disable

# GitHub OAuth application credentials.
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# Secret used to sign session and flash cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Public base URL of this application (no trailing slash).
APP_URL=http://localhost:8080

# HTTP listen port.
PORT=8080

# "development" or "production". In production, all secrets above are required
# and cookies are marked Secure.
ENVIRONMENT=development

# Mistral API key for content moderation. Create at: https://console.mistral.ai/
MISTRAL_API_KEY=

# Mistral model used for moderation classification.
MISTRAL_MODEL=mistral-small-latest
